{
  "name": "oppressor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:frontend": "quasar dev",
    "dev:backend": "bun --watch server/index.ts",
    "build": "quasar build",
    "build:backend": "bun build server/index.ts --outdir dist/server --target bun",
    "start": "bun dist/server/index.js",
    "seed": "bun run scripts/seed.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "pinia": "^3.0.4",
    "quasar": "^2.35.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.4",
    "@types/bun": "latest",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^1.0.0",
    "vue-tsc": "^3.3.14"
  }
}
